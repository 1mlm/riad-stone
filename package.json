    "@toolwind/corner-shape": "0.0.8-3",
    "@vercel/functions": "^3.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "nuqs": "^2.9.2",
    "prisma": "^7.9.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
