{
  "name": "nextjs-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "dev": "next dev -p 3006",
    "postinstall": "prisma generate",
    "build": "prisma generate && prisma migrate deploy && next build",
