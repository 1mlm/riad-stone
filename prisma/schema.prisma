generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Entree {
  // the reference is the entry's identity, not a generated id — a sortie
  // consumes an entree lot by pointing at this reference directly
  reference    String   @id
  designation  String
  date         DateTime @default(now()) @db.Date
  origine      String?
  conteneur    String?
  // stored in metres regardless of the unit picked in the UI (cm/mm/dm/m)
  longueur     Decimal  @db.Decimal(10, 4)
  largeur      Decimal  @db.Decimal(10, 4)
  nombrePieces Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // a lot can be sold across several partial sorties over time — the
  // pieces still in stock are nombrePieces minus the sum of sorties.nombrePieces
  sorties Sortie[]
}

model Sortie {
  id              Int      @id @default(autoincrement())
  entreeReference String
  entree          Entree   @relation(fields: [entreeReference], references: [reference])
  // pieces taken by this specific sortie — may be less than the entree's total
  nombrePieces    Int
  dateSortie      DateTime @default(now()) @db.Date
  bonCommande     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([entreeReference])
}

enum HistoryItemType {
  CREATE_INPUT
  UPDATE_INPUT
  DELETE_INPUT
  CREATE_OUTPUT
  UPDATE_OUTPUT
  DELETE_OUTPUT
  CLEAR_EVERYTHING
  SEED_FAKE_DATA
  LOGIN
  LOGOUT
  VIEW_PAGE
  SEARCH
  EXPORT_DATA
}

model HistoryEvent {
  id        Int             @id @default(autoincrement())
  type      HistoryItemType
  // shape depends on type: CREATE_*/DELETE_* store the full row snapshot,
  // UPDATE_* store { before, after } snapshots, CLEAR_EVERYTHING/SEED_FAKE_DATA
  // store counts, LOGIN stores the code that was used
  data      Json
  createdAt DateTime        @default(now())

  @@index([createdAt])
}
